        <mxCell id="e3" value="fused = True&#10;(--moe-permute-fusion)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.25;exitY=1;entryX=0.5;entryY=0;fontSize=11;fontStyle=1;" edge="1" parent="1" source="decide" target="p1">
